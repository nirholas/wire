# wire configuration. Copy to .env and fill in what you have.
# Nothing here is strictly required: wire runs with zero keys on its keyless lanes.

# ---------------------------------------------------------------------------
# LLM providers. First one configured wins; the rest are failover.
# Ordered for LATENCY, not quality, because the summary is on the critical path.
# ---------------------------------------------------------------------------
# Groq is the fastest hosted inference available and is the recommended primary.
GROQ_API_KEY=
# Anthropic gives the best summaries. Used first when WIRE_LLM_PREFER=quality.
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated extra OpenRouter keys, tried in order after the primary.
OPENROUTER_FALLBACK_KEYS=
GEMINI_API_KEY=

# "speed" (default) puts Groq/Cerebras first. "quality" puts Claude first.
# The read is the whole product, so if you have any budget at all, use quality.
WIRE_LLM_PREFER=speed

# Which Claude model the quality lane uses. Measured cost of one read at wire's
# prompt size (~1,516 input / ~400 output tokens), and the monthly cost at 100
# links a day:
#   claude-opus-5     $0.0176/read   ~$53/mo   best read (default)
#   claude-sonnet-5   $0.0105/read   ~$32/mo   ~60% the cost, still excellent
#   claude-haiku-4-5  $0.0035/read   ~$11/mo   cheapest Claude, fastest
WIRE_LLM_QUALITY_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# From @BotFather. Without it the bot lane is disabled and the web UI still works.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user ids allowed to use the bot. Empty = allow everyone
# who can reach it, which is fine for a private bot but not for a public one.
TELEGRAM_ALLOWED_USERS=
# "poll" (default, needs no public URL) or "webhook".
TELEGRAM_MODE=poll
# Only for webhook mode: the public https base for this server.
TELEGRAM_WEBHOOK_BASE=
# Generated if unset. Guards the webhook path against strangers.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
# Shared secret for the HTTP API. Empty = open (localhost use only).
WIRE_API_TOKEN=

# ---------------------------------------------------------------------------
# Latency budgets, in milliseconds. Tune these; they are the whole product.
# ---------------------------------------------------------------------------
# Hard ceiling on the resolver race. Anything slower is abandoned.
WIRE_BUDGET_MS=2500
# Whole-chain ceiling for the LLM summary, which runs after the race.
WIRE_LLM_BUDGET_MS=6000
# Per-resolver ceiling.
WIRE_RESOLVER_TIMEOUT_MS=4000

# ---------------------------------------------------------------------------
# Identification. The SEC requires a real contact string in the User-Agent for
# its EDGAR endpoints, and will hard-block you without one.
# ---------------------------------------------------------------------------
WIRE_CONTACT_EMAIL=
WIRE_USER_AGENT=

# ---------------------------------------------------------------------------
# Writable state: the sqlite cache, the resolution history, the cookie jar.
# Set this to a mounted volume in production (Fly uses /data). Left unset it
# stays inside the repo, which is what you want locally.
# ---------------------------------------------------------------------------
WIRE_DATA_DIR=

# ---------------------------------------------------------------------------
# Bring-your-own-subscription. Point this at a Netscape cookies.txt exported
# from a browser where YOU are logged in to outlets YOU pay for. See README.
# Relative paths resolve against WIRE_DATA_DIR. Defaults to cookies/jar.txt
# inside it, so leaving this empty puts the jar on your volume automatically.
# ---------------------------------------------------------------------------
WIRE_COOKIE_JAR=
